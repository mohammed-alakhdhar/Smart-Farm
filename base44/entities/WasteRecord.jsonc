{
  "name": "WasteRecord",
  "type": "object",
  "properties": {
    "waste_type": {
      "type": "string",
      "enum": [
        "\u0633\u0639\u0641 \u0627\u0644\u0646\u062e\u064a\u0644",
        "\u062c\u0631\u064a\u062f \u0627\u0644\u0646\u062e\u064a\u0644",
        "\u0644\u064a\u0641 \u0627\u0644\u0646\u062e\u064a\u0644",
        "\u0646\u0648\u0649 \u0627\u0644\u062a\u0645\u0631",
        "\u062a\u0645\u0648\u0631 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629 \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u063a\u0630\u0627\u0626\u064a",
        "\u0645\u062e\u0644\u0641\u0627\u062a \u0632\u0631\u0627\u0639\u064a\u0629 \u0623\u062e\u0631\u0649"
      ]
    },
    "quantity": {
      "type": "number",
      "description": "\u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u062a\u0648\u0641\u0631\u0629"
    },
    "quantity_unit": {
      "type": "string",
      "enum": [
        "\u0637\u0646",
        "\u0643\u064a\u0644\u0648\u063a\u0631\u0627\u0645",
        "\u0645\u062a\u0631 \u0645\u0643\u0639\u0628"
      ],
      "default": "\u0637\u0646"
    },
    "location": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0648\u0642\u0639"
    },
    "storage_condition": {
      "type": "string",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u062e\u0644\u0641\u0627\u062a \u0648\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u062e\u0632\u064a\u0646"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0635\u0648\u0631 \u0627\u0644\u0645\u062e\u0644\u0641\u0627\u062a (file_uri)"
    },
    "intent": {
      "type": "string",
      "enum": [
        "\u0628\u064a\u0639",
        "\u0646\u0642\u0644",
        "\u0627\u0633\u062a\u0641\u0627\u062f\u0629"
      ],
      "description": "\u0627\u0644\u0631\u063a\u0628\u0629"
    },
    "opportunities": {
      "type": "string",
      "description": "\u0641\u0631\u0635 \u0627\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u062a\u0645\u0644\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0645\u0633\u062c\u0644",
        "\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629",
        "\u062a\u0645 \u0627\u0644\u0631\u0628\u0637",
        "\u0645\u063a\u0644\u0642"
      ],
      "default": "\u0645\u0633\u062c\u0644"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "waste_type",
    "quantity",
    "location",
    "intent"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}