{
  "name": "Facility",
  "type": "object",
  "properties": {
    "facility_type": {
      "type": "string",
      "enum": [
        "\u0645\u0632\u0631\u0639\u0629",
        "\u0645\u0635\u0646\u0639"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0632\u0631\u0639\u0629 \u0623\u0648 \u0627\u0644\u0645\u0635\u0646\u0639"
    },
    "owner_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0627\u0644\u0643 \u0623\u0648 \u0627\u0644\u0645\u0633\u0624\u0648\u0644"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u062a\u0648\u0627\u0635\u0644"
    },
    "city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "region": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0646\u0637\u0642\u0629"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    }
  },
  "required": [
    "facility_type",
    "name",
    "owner_name",
    "phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}